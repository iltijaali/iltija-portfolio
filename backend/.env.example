PORT=3001
FRONTEND_ORIGIN=http://localhost:5175

# SMTP credentials for the contact form (e.g. a Gmail App Password:
# https://myaccount.google.com/apppasswords). Copy this file to .env
# and fill these in — the contact form returns a friendly error until
# they're set, it will not crash the server.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_RECEIVER_EMAIL=iltijaali164@gmail.com
